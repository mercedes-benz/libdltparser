get_filename_component(DLTPARSER_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
include(CMakeFindDependencyMacro)

list(APPEND CMAKE_MODULE_PATH ${DLTPARSER_CMAKE_DIR})

list(REMOVE_AT CMAKE_MODULE_PATH -1)

if(NOT TARGET DLTParser::DLTParser)
    include("${DLTPARSER_CMAKE_DIR}/DLTParserTargets.cmake")
endif()

set(DLTParser_LIBRARIES DLTParser::DLTParser)