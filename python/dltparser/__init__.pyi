from typing import List, Tuple, Dict, Optional, Union, Iterator, overload

class Settings:
    class RePattern:
        REGEX_MATCH: "Settings.RePattern"
        REGEX_SEARCH: "Settings.RePattern"

    def __init__(
        self,
        *,
        msg_buf_res_count: int = 0x1E8480,
        with_raw_in_hex: bool = False,
        substr_strs: List[str] = ...,
        re_strs: List[Tuple[str, "Settings.RePattern"]] = ...,
    ) -> None: ...
    
    def with_substr(self) -> bool: ...
    def with_regex_search(self) -> bool: ...
    def with_regex_match(self) -> bool: ...
    def get_with_raw_in_hex(self) -> bool: ...
    def get_msg_buffer_reserve_count(self) -> int: ...
    def get_substr_strs(self) -> List[str]: ...
    def get_search_regex_strs(self) -> List[str]: ...
    def get_match_regex_strs(self) -> List[str]: ...


class Payload:
    class Type:
        DEFAULT: "Payload.Type"
        VERBOSE: "Payload.Type"
        NON_VERBOSE: "Payload.Type"

    def get_msg_id(self) -> int: ...
    def get_type(self) -> "Payload.Type": ...
    def get_data(self) -> str: ...
    def to_string(self) -> str: ...


class StorageHeader:
    def get_timestamp_str(self) -> str: ...
    def get_timestamp_s(self) -> int: ...
    def get_timestamp_ms(self) -> int: ...
    def get_ecu_id_str(self) -> str: ...


class ExtendedHeader:
    def get_verbosity(self) -> int: ...
    def get_verbosity_str(self) -> str: ...
    def get_msg_type(self) -> int: ...
    def get_msg_type_str(self) -> str: ...
    def get_msg_type_info(self) -> int: ...
    def get_msg_type_info_str(self) -> str: ...
    def get_num_args(self) -> int: ...
    def get_non_verb_msg_id(self) -> int: ...
    def get_apid_str(self) -> str: ...
    def get_ctid_str(self) -> str: ...


class Header:
    def get_header_type(self) -> int: ...
    def get_msg_count(self) -> int: ...
    def get_msg_len(self) -> int: ...
    def get_ecu_id_str(self) -> str: ...
    def get_session_id(self) -> int: ...
    def to_string(self) -> str: ...
    def get_msg_idx(self) -> int: ...


class DLTFile:
    def __init__(self, filepath: str) -> None: ...
    def __init__(self, filepath: str, settings: Settings) -> None: ...

    def parse(self) -> bool: ...
    def save_messages(self, filepath: str) -> bool: ...
    def save_hits(self, filepath: str) -> bool: ...
    def get_messages(self) -> List[Tuple[Header, Payload]]: ...
    def get_hits(self) -> Dict[str, List[Tuple[Header, Payload]]]: ...
    def is_read(self) -> bool: ...
    def size(self) -> int: ...
